{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "checkJs": true,
    "maxNodeModuleJsDepth": 0,
    "skipLibCheck": true,
    "types": ["node"],
    "strict": false,
    "noEmit": true
  },
  "include": ["*.js", "tests/**/*.js"],
  "exclude": ["node_modules", "vendor", "service-worker.js"]
}
